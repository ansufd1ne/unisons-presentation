---
import { social } from '../data/site';
import { ctaIcons } from '../data/ctaIcons';
// Même ordre que la maquette : Facebook, YouTube, Instagram, SoundCloud
const order = ['Facebook', 'YouTube', 'Instagram', 'SoundCloud'];
const links = order.map((label) => social.find((s) => s.label === label)!).filter(Boolean);
const icon = (i: number) => ctaIcons[i] ?? ctaIcons[2];
---
<section class="cta" aria-labelledby="cta-title">
  <h2 id="cta-title" class="display" data-reveal="bottom">Restez dans le rythme</h2>
  <ul>
    {links.map((s, i) => (
      <li data-reveal="bottom" data-reveal-delay={120 + i * 110}><a href={s.href} target="_blank" rel="noopener"><span class="disc" aria-hidden="true"></span><span class="display">[ {s.label} ]</span><span class="ic" aria-hidden="true" set:html={icon(i)} /><span class="visually-hidden"> (nouvel onglet)</span></a></li>
    ))}
  </ul>
</section>

<style>
  .cta { background: var(--accent); color: var(--ink); padding: 100px var(--pad) 80px; display: flex; flex-direction: column; }
  h2 { color: var(--ink); font-size: min(150px, 10.4vw); line-height: 1.05; white-space: nowrap; letter-spacing: -0.03em; }
  ul { margin-top: 64px; border-top: 1px solid rgba(11, 11, 13, .25); }
  li { border-bottom: 1px solid rgba(11, 11, 13, .25); transition: border-color .4s ease; }
  a { position: relative; overflow: hidden; display: flex; justify-content: space-between; align-items: center; padding: 22px 0; }
  a .display { position: relative; z-index: 1; color: var(--ink); font-size: 48px; line-height: 1; transition: transform .4s ease, color .4s ease; }
  .ic { position: relative; z-index: 1; color: var(--ink); font-size: 40px; line-height: 0; transition: transform .4s ease, color .4s ease; }
  .ic :global(svg) { display: block; width: 64px; height: 64px; }

  /* Survol : un disque noir monte et remplit la ligne, le nom glisse vers la droite et l'icône vers la gauche (2 rem) ;
     texte et icône passent à l'or, lisibles sur le noir. */
  .disc { position: absolute; left: -82px; top: -100%; width: 200%; height: 300%; border-radius: 100%; background: var(--ink); transform: translateY(103%); transition: transform 1s cubic-bezier(.22, 1, .36, 1); pointer-events: none; }
  li:has(a:focus-visible) { border-bottom-color: var(--ink); }
  a:focus-visible { outline-color: var(--accent); outline-offset: -3px; }
  a:focus-visible .disc { transform: translateY(0); }
  a:focus-visible .display, a:focus-visible .ic { color: var(--accent); }
  a:focus-visible .display { transform: translateX(2rem); }
  a:focus-visible .ic { transform: translateX(-2rem); }
  @media (hover: hover) {
    li:hover { border-bottom-color: var(--ink); }
    a:hover .disc { transform: translateY(0); }
    a:hover .display, a:hover .ic { color: var(--accent); }
    a:hover .display { transform: translateX(2rem); }
    a:hover .ic { transform: translateX(-2rem); }
  }
  @media (max-width: 900px) {
    .cta { padding-block: 56px; }
    ul { margin-top: 40px; }
    h2 { font-size: 11vw; white-space: normal; }
    a .display { font-size: 30px; }
    .ic :global(svg) { width: 40px; height: 40px; }
  }
</style>
