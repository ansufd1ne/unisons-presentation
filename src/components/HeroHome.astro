---
import { Picture } from 'astro:assets';
import hero from '../assets/photos/hero.jpg';
import { site } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="bg" data-scrub data-trigger=".hero" data-range="top-top" data-y="0,9">
    <Picture src={hero} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 1080, 1600, 2400]} sizes="100vw" alt="Concert hip-hop UNi’SONS : un artiste sur scène devant un public aux mains levées" loading="eager" fetchpriority="high" />
  </div>
  <div class="veil" aria-hidden="true"></div>
  <h1 id="hero-title" class="display gold" data-scrub data-trigger=".hero" data-range="top-top" data-y="0px,-70px"><span class="in">UN<span class="lc">i</span>’SONS</span><span class="visually-hidden">, l’école du son</span></h1>
  <div class="foot">
    <p class="intro upper">L’école du son : hip-hop, arts du monde arabe, éducation artistique et accompagnement des musiciens, à Montpellier.</p>
    <ul class="links">
      <li><a class="bracket" href="/agenda">Agenda</a></li>
      <li><a class="bracket" href={site.festival + '/'} target="_blank" rel="noopener">Arabesques ↗<span class="visually-hidden"> (site du festival, nouvel onglet)</span></a></li>
      <li><a class="bracket" href="/kosmik-hip-hop">Kosmik Hip-Hop</a></li>
    </ul>
  </div>
</section>

<style>
  .hero { position: relative; display: grid; place-items: center; height: clamp(620px, 100svh, 1024px); background: #000; color: #fff; overflow: clip; }
  .bg { position: absolute; inset: -5% 0; }
  .bg :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .veil { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0, 0, 0, .6), rgba(0, 0, 0, .12) 45%, rgba(0, 0, 0, .86)); }
  h1 { position: relative; font-size: min(26.2vw, 440px); line-height: 1; letter-spacing: -0.02em; text-align: center; margin-top: -4vh; }
  .in { display: inline-block; }
  .foot { position: absolute; left: var(--pad); right: var(--pad); bottom: 40px; display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .intro { max-width: 424px; color: #fff; font-size: 15px; line-height: 24px; }
  .links { display: flex; gap: 40px; }
  .links .bracket { color: #fff; font-size: 15px; white-space: nowrap; }
  .links .bracket:hover, .links .bracket:focus-visible { color: var(--accent); }
  :global(.hero :focus-visible) { outline-color: var(--accent); }
  @media (max-width: 900px) {
    .hero { height: clamp(560px, 92svh, 760px); }
    h1 { font-size: 24vw; margin-top: -10vh; }
    .foot { flex-direction: column; align-items: flex-start; gap: 20px; bottom: 28px; }
    .links { flex-wrap: wrap; gap: 14px 24px; }
  }
  @media (max-width: 1100px) and (min-width: 901px) { .links { gap: 24px; } }

  /* Ouverture : le mot monte depuis un masque, le pied de hero apparaît ensuite */
  :global(html.intro-ready) .hero .in { animation: hero-rise .8s cubic-bezier(.37, 0, .63, 1) both; }
  :global(html.intro-ready) .hero .foot { animation: hero-fade .7s cubic-bezier(.37, 0, .63, 1) .45s both; }
  :global(html.intro-ready) .hero .bg :global(img) { animation: hero-zoom 1.1s cubic-bezier(.47, 0, .745, .715) both; }
  h1 { overflow: clip; padding-bottom: .04em; }
  @keyframes hero-rise { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes hero-fade { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes hero-zoom { from { transform: scale(1.12); } to { transform: none; } }
</style>
