---
import '../data/nav-cms'; // rubriques Sanity appliquées à `nav` avant lecture
import logoColor from '../assets/logo/unisons.svg';
import logoWhite from '../assets/logo/unisons-blanc.svg';
import { nav, social } from '../data/site';
interface Props { dark?: boolean; }
const { dark = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class={`nav${dark ? ' dark' : ''}`}>
  <a class="brand" href="/" aria-label="UNi’SONS, accueil">
    <img class="logo-c" src={logoColor.src} alt="UNi’SONS" width="131" height="28" />
    <img class="logo-w" src={logoWhite.src} alt="" width="131" height="28" aria-hidden="true" />
  </a>
  <nav class="links" aria-label="Navigation principale">
    {nav.filter((l) => l.bar).map((l) => (
      <a href={l.href} aria-current={current(l.href) ? 'page' : undefined} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
        {l.label}{l.external && <span class="visually-hidden"> (site du festival, nouvel onglet)</span>}
      </a>
    ))}
    <span class="dot" aria-hidden="true"></span>
  </nav>
  <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu-overlay" id="menu-open">Menu</button>

  <dialog id="menu-overlay" aria-label="Menu">
    <div class="ov-top">
      <a class="brand" href="/" aria-label="Accueil"><img src={logoColor.src} alt="UNi’SONS" width="131" height="28" /></a>
      <button class="menu-btn" type="button" id="menu-close">Fermer</button>
    </div>
    <ul class="ov-grid">
      {nav.map((g, i) => (
        <li class="grp" style={`--k:${i}`}>
          <a class="display g-title" href={g.href} {...(g.external ? { target: '_blank', rel: 'noopener' } : {})}>
            {g.label}{g.external && <span aria-hidden="true"> ↗</span>}{g.external && <span class="visually-hidden"> (site du festival, nouvel onglet)</span>}
          </a>
          {g.children && (
            <ul class="g-sub">
              {g.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <ul class="ov-social">
      {social.map((s, i) => <li style={`--k:${nav.length + i}`}><a class="bracket" href={s.href} rel="noopener" target="_blank">{s.label}<span class="visually-hidden"> (nouvel onglet)</span></a></li>)}
    </ul>
  </dialog>
</header>

<style>
  .nav {
    position: absolute; inset: 0 0 auto 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between;
    height: 84px; padding: 0 var(--pad);
  }
  .brand img { height: 28px; width: auto; }
  .logo-w { display: none; }
  /* page à hero sombre : barre blanche sur la photo ; le menu plein écran reste clair */
  .dark > .brand .logo-c { display: none; }
  .dark > .brand .logo-w { display: block; }
  .dark > .links a, .dark > .menu-btn { color: #fff; }
  .dark > .links a:hover, .dark > .menu-btn:hover { color: var(--accent); }
  .dark > .links a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--accent); }
  .links { display: none; align-items: center; gap: 48px; margin-left: auto; margin-right: 44px; }
  .dot { width: 8px; height: 8px; margin-left: 8px; background: var(--strong); }
  .dark > .links .dot { background: #fff; }
  .links a, .menu-btn {
    font: 500 14px/1 var(--font-body); letter-spacing: .2em; text-transform: uppercase; white-space: nowrap;
    color: var(--strong); background: none; border: 0; cursor: pointer; padding: 8px 0;
  }
  .links a:hover, .menu-btn:hover { color: var(--accent-ink); }
  .links a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--accent); }
  .menu-btn { margin-left: auto; padding: 8px 0 8px 12px; }
  /* les quatre entrées de la barre tiennent dès 1000 px ; en dessous, le bouton Menu donne accès à tout */
  @media (min-width: 1000px) {
    .links { display: flex; }
    .menu-btn { margin-left: 0; }
  }
  dialog {
    inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; overflow-y: auto;
    margin: 0; border: 0; padding: 0 var(--pad) 48px; background: var(--bg); color: var(--text);
  }
  dialog::backdrop { background: var(--bg); }
  .ov-top { display: flex; justify-content: space-between; align-items: center; height: 84px; }
  .ov-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px 40px; margin-top: 32px; }
  .g-title { display: inline-block; font-size: var(--text-3xl); line-height: 1.1; }
  .g-title:hover, .g-title:focus-visible { color: var(--accent-ink); }
  .g-sub { display: grid; gap: 10px; margin-top: 14px; }
  .g-sub a { font: 500 14px/1.3 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .g-sub a:hover, .g-sub a:focus-visible { color: var(--accent-ink); }
  .ov-social { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  @media (max-width: 900px) {
    .nav { height: 72px; }
    .ov-top { height: 72px; }
    .ov-grid { grid-template-columns: 1fr; gap: 28px; margin-top: 16px; }
  }
  @media (min-width: 901px) and (max-width: 1100px) { .ov-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
  const dlg = document.getElementById('menu-overlay') as HTMLDialogElement | null;
  const lock = (on: boolean) => { document.documentElement.style.overflow = on ? 'hidden' : ''; };
  document.getElementById('menu-open')?.addEventListener('click', () => { dlg?.showModal(); lock(true); });
  dlg?.addEventListener('close', () => lock(false)); // Échap, bouton Fermer ou clic sur un lien
  document.getElementById('menu-close')?.addEventListener('click', () => dlg?.close());
  dlg?.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName === 'A') dlg.close(); });
</script>
