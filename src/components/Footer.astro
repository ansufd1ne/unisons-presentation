---
import '../data/nav-cms'; // rubriques Sanity appliquées à `nav` avant lecture
import logo from '../assets/logo/unisons-blanc.svg';
import { nav, legal, site, social } from '../data/site';
const year = new Date().getFullYear();
const poles = nav.filter((n) => n.children || n.external);
const cols = [
  { title: 'Nos pôles', links: poles.filter((n) => !['/l-association', '/infos-pratiques'].includes(n.href)) },
  { title: 'L’association', links: [nav.find((n) => n.href === '/l-association')!, ...nav.find((n) => n.href === '/l-association')!.children!] },
  { title: 'Infos', links: [{ label: 'Agenda', href: '/agenda' }, ...nav.filter((n) => n.href === '/infos-pratiques'), ...nav.find((n) => n.href === '/infos-pratiques')!.children!, ...legal] },
];
---
<footer class="footer">
  <div class="top" data-reveal="bottom">
    <div class="id">
      <img class="logo" src={logo.src} alt="UNi’SONS" width="131" height="28" />
      <address>
        <p>{site.org}<br />{site.address[0]}<br />{site.address[1]}</p>
        <p><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>
      </address>
      <ul class="social">
        {social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}<span class="visually-hidden"> (nouvel onglet)</span></a></li>)}
      </ul>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <h2 class="label">{c.title}</h2>
        <ul>{c.links.map((l) => <li><a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}{l.external && <span aria-hidden="true"> ↗</span>}{l.external && <span class="visually-hidden"> (nouvel onglet)</span>}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <p class="copy">© {year} {site.org}. Tous droits réservés. <button type="button" class="cc" data-consent-open>Gérer les cookies</button></p>
  <p class="word display gold" aria-hidden="true">UN<span class="lc">i</span>’SONS</p>
</footer>

<style>
  .footer { background: var(--dark); color: var(--on-dark); padding: 80px var(--pad) 0; overflow: hidden; }
  .top { display: grid; grid-template-columns: 1.2fr 1fr 1fr 1fr; gap: 40px; }
  .logo { height: 28px; width: auto; }
  address { font-style: normal; margin-top: 32px; font-size: 14px; line-height: 22px; }
  address p + p { margin-top: 14px; font-weight: 500; }
  address a:hover, address a:focus-visible { color: var(--accent); }
  .social { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 24px; }
  .social a { font: 500 12px/1.3 var(--font-body); letter-spacing: .15em; text-transform: uppercase; color: var(--on-dark); }
  .social a:hover, .social a:focus-visible { color: var(--accent); }
  .label { color: var(--accent); }
  nav ul { margin-top: 24px; display: grid; gap: 16px; }
  nav a { font: 500 13px/1.3 var(--font-body); letter-spacing: .12em; text-transform: uppercase; color: var(--on-dark); }
  nav a:hover, nav a:focus-visible { color: var(--accent); }
  :global(.footer :focus-visible) { outline-color: var(--accent); }
  .copy { position: relative; z-index: 2; margin-top: 56px; font-size: 14px; color: #a9a89f; }
  .cc { margin-left: 12px; font: inherit; color: var(--on-dark); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .cc:hover, .cc:focus-visible { color: var(--accent); }
  .word { font-size: 21.5vw; line-height: .86; letter-spacing: -0.02em; text-align: center; margin: 48px 0 -2.2vw; white-space: nowrap; }
  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr 1fr; gap: 36px 20px; }
    .id { grid-column: 1 / -1; }
    .word { font-size: 19vw; }
  }
  /* 320 px (reflow WCAG 1.4.10) */
  @media (max-width: 380px) { .top { grid-template-columns: minmax(0, 1fr); } }
</style>
