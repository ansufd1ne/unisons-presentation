---
import { Picture } from 'astro:assets';
import { poles } from '../data/home';
const n = poles.length;
---
<section class="poles" data-stack aria-labelledby="poles-title" style={`--n:${n}`}>
  <div class="stage">
    <div class="head">
      <p class="label">Programmes</p>
      <h2 id="poles-title" class="display">Nos pôles d’action</h2>
    </div>
    <ol class="cards">
      {poles.map((p, i) => (
        <li class="card" data-card style={`z-index:${10 - i}`}>
          <Picture src={p.img} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 560px" alt={p.alt} loading="lazy" />
          <div class="txt">
            <p class="label">{String(i + 1).padStart(2, '0')} / {String(n).padStart(2, '0')}</p>
            <h3 class="display"><span class="nw">{p.name}{p.external && <span class="arrow" aria-hidden="true">↗</span>}</span></h3>
            <p class="detail">{p.text}</p>
            <a class="bracket" href={p.href} {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}>Découvrir{p.external && <span class="visually-hidden"> (site du festival, nouvel onglet)</span>}</a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .poles { height: calc(100vh + var(--n) * 75vh); padding: 0 var(--pad); background: var(--bg); }
  .stage { position: sticky; top: 0; height: 100vh; display: grid; align-content: center; gap: 28px; perspective: 1200px; }
  .head h2 { font-size: var(--text-5xl); line-height: 1.1; margin-top: 16px; }
  .cards { position: relative; height: min(58vh, 520px); }
  .card { position: absolute; inset: 0; display: grid; grid-template-columns: 1.15fr 1fr; background: var(--bg-2); border: 1px solid var(--line); overflow: hidden; will-change: transform, opacity; }
  .card :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .txt { display: flex; flex-direction: column; gap: 14px; padding: 36px; }
  .txt h3 { font-size: clamp(34px, 4.6vw, var(--text-4xl)); line-height: 1.05; }
  .nw { white-space: nowrap; }
  .arrow { display: inline-block; margin-left: .2em; font-size: .5em; vertical-align: .55em; }
  .detail { max-width: 380px; }
  .txt .bracket { margin-top: auto; align-self: start; }
  @media (max-width: 900px) {
    .poles { height: auto; padding-block: 56px; }
    .stage { position: static; height: auto; perspective: none; }
    .cards { height: auto; display: grid; gap: 20px; }
    .card { position: static; grid-template-columns: minmax(0, 1fr); }
    .nw { white-space: normal; overflow-wrap: anywhere; }
    .card :global(img) { aspect-ratio: 4 / 3; height: auto; }
    .txt { padding: 24px; }
  }
</style>
