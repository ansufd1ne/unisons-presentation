---
import { Picture } from 'astro:assets';
import portrait from '../assets/photos/quote.jpg';
---
<section class="quote" aria-labelledby="quote-title">
  <h2 id="quote-title" class="word display" data-scrub data-trigger=".quote" data-x="5,-5" data-smooth=".1">Insertion</h2>
  <div class="body">
    <Picture class="portrait" src={portrait} formats={['avif', 'webp']} fallbackFormat="webp" widths={[216, 432]} sizes="216px" alt="Portrait en noir et blanc d’un jeune accompagné par UNi’SONS" loading="lazy" data-reveal="left" />
    <blockquote>
      <p class="display l1" data-highlight>« L’insertion par la culture est un défi</p>
      <p class="display l2" data-highlight>sur lequel UNi’SONS s’engage depuis plusieurs années. »</p>
    </blockquote>
  </div>
</section>

<style>
  .quote { padding: 120px 0 140px; overflow: clip; }
  .word { font-size: 27.8vw; line-height: .9; letter-spacing: -0.02em; text-align: center; white-space: nowrap; padding-bottom: .04em; }
  .body { display: grid; grid-template-columns: 216px 1fr; gap: 94px; align-items: start; margin-top: 150px; padding: 0 var(--pad); }
  .portrait { width: 216px; height: 255px; object-fit: cover; filter: grayscale(1); }
  blockquote { margin: 0; }
  blockquote .display { font-size: var(--text-5xl); line-height: 1.12; }
  .l2 { margin-left: min(12vw, 174px); }
  @media (max-width: 900px) {
    .quote { padding: 72px 0 80px; }
    .word { font-size: 24vw; }
    .body { grid-template-columns: 1fr; gap: 28px; margin-top: 48px; }
    .portrait { width: 140px; height: 165px; }
    .l2 { margin-left: 0; }
  }
</style>
