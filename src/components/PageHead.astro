---
interface Props { label: string; title: string; sub?: string; align?: 'center' | 'left'; }
const { label, title, sub, align = 'center' } = Astro.props;
---
<header class={`head ${align}`}>
  <p class="label" data-intro="fade" data-scrub data-trigger="header" data-range="top-top" data-y="0px,-60px">{label}</p>
  <h1 class="display" data-intro="words" data-scrub data-trigger="header" data-range="top-top" data-y="0px,-60px">{title}</h1>
  {sub && <p class="sub upper" data-intro="fade" data-scrub data-trigger="header" data-range="top-top" data-y="0px,-60px">{sub}</p>}
</header>

<style>
  .head { padding: 170px var(--pad) 56px; }
  .center { text-align: center; }
  h1 { font-size: var(--text-6xl); line-height: 1.05; margin-top: 28px; }
  .sub { margin-top: 24px; }
  @media (max-width: 900px) { .head { padding-top: 120px; } }
</style>
